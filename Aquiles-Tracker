import React, { useState, useEffect } from 'react';
import { Plus, TrendingUp, Settings, Download, Home, BarChart3, Clock, Play, Pause, X, Cloud, AlertCircle, Music, Zap } from 'lucide-react';

// Configuración de Google OAuth (reemplazar con tus credenciales)
const GOOGLE_CLIENT_ID = 'YOUR_CLIENT_ID.apps.googleusercontent.com';
const GOOGLE_REDIRECT_URI = window.location.origin + '/callback';
const GOOGLE_SCOPES = [
  'https://www.googleapis.com/auth/calendar',
  'https://www.googleapis.com/auth/drive.readonly',
  'https://www.googleapis.com/auth/spreadsheets'
].join(' ');

function calcularDescansoSugerido(ejercicio, rpe, objetivo = 'fuerza') {
  const ejerciciosPesados = ['Press de Banca', 'Sentadilla Libre', 'P. Muerto Rumano', 'Prensa de Pierna', 'Jalones al Pecho'];
  const ejerciciosIsolados = ['Curl de Bíceps', 'Elevaciones Laterales', 'Curl Femoral', 'Crunch de Abs con Polea', 'Face Pulls'];
  const ejerciciosPoliartic = ['Fondos', 'Dominada Libre', 'Dominada LASTRE', 'Remo en Máquina'];

  let descansoBase = 90;
  if (ejerciciosPesados.includes(ejercicio)) descansoBase = 180;
  else if (ejerciciosPoliartic.includes(ejercicio)) descansoBase = 150;
  else if (ejerciciosIsolados.includes(ejercicio)) descansoBase = 60;

  if (rpe >= 9.5) descansoBase += 60;
  if (rpe >= 9) descansoBase += 30;
  if (rpe <= 6) descansoBase -= 30;

  if (objetivo === 'hipertrofia') descansoBase -= 15;
  if (objetivo === 'fuerza') descansoBase += 30;

  return Math.max(45, descansoBase);
}

export default function EntrenadorAquiles() {
  const [pantalla, setPantalla] = useState('entrada');
  const [entrenamientos, setEntrenamientos] = useState([]);
  const [googleAuth, setGoogleAuth] = useState(null);
  const [sincronizando, setSincronizando] = useState(false);
  const [ejercicios, setEjercicios] = useState([
    'Press de Banca', 'Prensa de Pierna', 'Jalones al Pecho', 'Sentadilla Libre',
    'P. Muerto Rumano', 'Curl de Bíceps', 'Remo en Máquina', 'Elevaciones Laterales',
    'Fondos', 'Curl Femoral', 'Abductores Apertura', 'Extensiones Cuádriceps',
    'Press Militar', 'Predicador de Tríceps', 'Carga del Granjero', 'Crunch de Abs con Polea',
    'Pantorrillas (Plataforma)', 'Face Pulls', 'Peck Deck', 'P. Muerto Rumano Unilateral',
    'Remo con Mancuernas', 'Dominada Libre', 'Dominada LASTRE', 'Elevaciones Laterales con Cable'
  ].sort());
  const [timerVisible, setTimerVisible] = useState(false);
  const [timerData, setTimerData] = useState(null);
  const [notificaciones, setNotificaciones] = useState([]);

  // Cargar datos
  useEffect(() => {
    const datosGuardados = localStorage.getItem('entrenamientos');
    if (datosGuardados) setEntrenamientos(JSON.parse(datosGuardados));

    // Verificar Google Auth
    const token = localStorage.getItem('google_token');
    if (token) setGoogleAuth(token);

    // Service Worker para notificaciones
    if ('serviceWorker' in navigator) {
      navigator.serviceWorker.register('/sw.js').catch(() => {});
    }

    // Request para notificaciones
    if ('Notification' in window && Notification.permission === 'default') {
      Notification.requestPermission();
    }
  }, []);

  // Guardar entrenamientos
  const guardarEntrenamiento = async (nuevoEntrenamiento) => {
    const actualizado = [...entrenamientos, { ...nuevoEntrenamiento, id: Date.now() }];
    setEntrenamientos(actualizado);
    localStorage.setItem('entrenamientos', JSON.stringify(actualizado));

    // Sincronizar con Google Calendar si está conectado
    if (googleAuth) {
      await sincronizarConCalendar(nuevoEntrenamiento);
    }

    // Notificación
    mostrarNotificacion(`✅ ${nuevoEntrenamiento.ejercicio} guardado`, 'success');
  };

  // Sincronizar con Google Calendar
  const sincronizarConCalendar = async (entrenamiento) => {
    setSincronizando(true);
    try {
      const evento = {
        summary: `🏋️ ${entrenamiento.ejercicio} - ${entrenamiento.carga}kg x${entrenamiento.reps}`,
        description: `RPE: ${entrenamiento.rpe}\nVolumen: ${entrenamiento.carga * entrenamiento.reps}kg\nObjetivo: ${entrenamiento.objetivo}${entrenamiento.notas ? '\nNotas: ' + entrenamiento.notas : ''}`,
        start: { dateTime: new Date(entrenamiento.fecha).toISOString() },
        end: { dateTime: new Date(entrenamiento.fecha + 600000).toISOString() },
        colorId: '1', // Tomato
      };

      const response = await fetch('https://www.googleapis.com/calendar/v3/calendars/primary/events', {
        method: 'POST',
        headers: {
          'Authorization': `Bearer ${googleAuth}`,
          'Content-Type': 'application/json'
        },
        body: JSON.stringify(evento)
      });

      if (response.ok) {
        mostrarNotificacion('📅 Sincronizado con Google Calendar', 'success');
      }
    } catch (error) {
      console.error('Error sincronizando:', error);
      mostrarNotificacion('❌ Error al sincronizar con Calendar', 'error');
    }
    setSincronizando(false);
  };

  // Mostrar notificación
  const mostrarNotificacion = (mensaje, tipo = 'info') => {
    const id = Date.now();
    const notif = { id, mensaje, tipo };
    setNotificaciones([...notificaciones, notif]);
    setTimeout(() => {
      setNotificaciones(prev => prev.filter(n => n.id !== id));
    }, 3000);

    // Push notification si está permitida
    if ('Notification' in window && Notification.permission === 'granted') {
      new Notification('AQUILES TRACKER', { body: mensaje, icon: '🏋️' });
    }
  };

  // Login Google
  const loginGoogle = () => {
    const authUrl = `https://accounts.google.com/o/oauth2/v2/auth?` +
      `client_id=${GOOGLE_CLIENT_ID}&` +
      `redirect_uri=${GOOGLE_REDIRECT_URI}&` +
      `response_type=token&` +
      `scope=${GOOGLE_SCOPES}`;
    window.location.href = authUrl;
  };

  // Logout Google
  const logoutGoogle = () => {
    localStorage.removeItem('google_token');
    setGoogleAuth(null);
    mostrarNotificacion('❌ Sesión de Google cerrada', 'info');
  };

  // Export a Excel
  const exportarExcel = () => {
    if (entrenamientos.length === 0) {
      alert('No hay datos para exportar');
      return;
    }

    let csv = 'Fecha,Ejercicio,Carga (kg),Reps,RPE,Volumen (kg),Variación,Dropset,Objetivo,Notas\n';
    entrenamientos.forEach(e => {
      const fecha = new Date(e.fecha).toLocaleDateString('es-CL');
      const variacion = e.variacion || '-';
      const dropset = e.esDropSet ? 'Sí' : 'No';
      const notas = (e.notas || '').replace(/,/g, ';');
      const volumen = e.carga * e.reps;
      csv += `${fecha},"${e.ejercicio}",${e.carga},${e.reps},${e.rpe},${volumen},"${variacion}","${dropset}","${e.objetivo || '-'}","${notas}"\n`;
    });

    const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
    const link = document.createElement('a');
    link.href = URL.createObjectURL(blob);
    link.download = `EntrenamientosAquiles_${new Date().toISOString().split('T')[0]}.csv`;
    link.click();
  };

  return (
    <div className="min-h-screen bg-gradient-to-br from-slate-900 via-slate-800 to-black text-white font-sans">
      {/* Header */}
      <div className="bg-gradient-to-r from-red-600 to-orange-600 p-4 sticky top-0 z-50 shadow-lg">
        <h1 className="text-2xl font-black text-center">🏋️ AQUILES TRACKER v2</h1>
        <div className="flex justify-center gap-2 mt-2 text-xs">
          {googleAuth && <span className="bg-green-600 px-2 py-1 rounded-full flex items-center gap-1">✅ Google conectado</span>}
          {sincronizando && <span className="bg-blue-600 px-2 py-1 rounded-full animate-pulse">🔄 Sincronizando...</span>}
        </div>
      </div>

      {/* Notificaciones flotantes */}
      <div className="fixed top-20 right-4 z-40 space-y-2">
        {notificaciones.map(notif => (
          <div
            key={notif.id}
            className={`px-4 py-2 rounded-lg font-bold text-sm shadow-lg animate-bounce ${
              notif.tipo === 'success' ? 'bg-green-600' :
              notif.tipo === 'error' ? 'bg-red-600' :
              'bg-blue-600'
            }`}
          >
            {notif.mensaje}
          </div>
        ))}
      </div>

      {/* PANTALLA DE ENTRADA RÁPIDA */}
      {pantalla === 'entrada' && (
        <PantallaEntrada
          guardarEntrenamiento={guardarEntrenamiento}
          ejercicios={ejercicios}
          onIniciarTimer={(ejercicio, rpe, objetivo) => {
            const descanso = calcularDescansoSugerido(ejercicio, rpe, objetivo);
            setTimerData({ descanso, ejercicio, rpe });
            setTimerVisible(true);
          }}
        />
      )}

      {/* PANTALLA DE HISTORIAL */}
      {pantalla === 'historial' && <PantallaHistorial entrenamientos={entrenamientos} setEntrenamientos={setEntrenamientos} />}

      {/* PANTALLA DE DASHBOARD */}
      {pantalla === 'dashboard' && <PantallaDashboard entrenamientos={entrenamientos} />}

      {/* PANTALLA DE CONFIG */}
      {pantalla === 'config' && (
        <div className="p-4 pb-32 space-y-4">
          <div className="bg-slate-700 rounded-lg p-4 space-y-3">
            <h2 className="text-lg font-bold mb-4">⚙️ Configuración</h2>

            {/* Google Auth */}
            <div className="bg-slate-600 rounded-lg p-4 border-l-4 border-blue-500">
              <p className="text-sm font-bold mb-2">☁️ Google Workspace</p>
              {googleAuth ? (
                <>
                  <p className="text-xs text-gray-300 mb-3">✅ Conectado</p>
                  <button
                    onClick={logoutGoogle}
                    className="w-full bg-red-600 hover:bg-red-700 py-2 rounded-lg font-bold text-sm"
                  >
                    Desconectar Google
                  </button>
                </>
              ) : (
                <>
                  <p className="text-xs text-gray-300 mb-3">📅 Sincroniza con Calendar y Drive</p>
                  <button
                    onClick={loginGoogle}
                    className="w-full bg-blue-600 hover:bg-blue-700 py-2 rounded-lg font-bold text-sm flex items-center justify-center gap-2"
                  >
                    <Cloud size={16} /> Conectar Google
                  </button>
                </>
              )}
            </div>

            {/* Export Excel */}
            <button
              onClick={exportarExcel}
              className="w-full bg-green-600 hover:bg-green-700 py-3 rounded-lg font-bold flex items-center justify-center gap-2"
            >
              <Download size={20} /> Descargar Excel
            </button>

            {/* Stats */}
            <div className="grid grid-cols-2 gap-3 text-xs">
              <div className="bg-slate-600 p-3 rounded text-center">
                <p className="text-gray-400">Entrenamientos</p>
                <p className="font-black text-orange-400 text-lg">{entrenamientos.length}</p>
              </div>
              <div className="bg-slate-600 p-3 rounded text-center">
                <p className="text-gray-400">Volumen Total</p>
                <p className="font-black text-orange-400 text-lg">
                  {entrenamientos.reduce((sum, e) => sum + (e.carga * e.reps), 0).toFixed(0)}kg
                </p>
              </div>
            </div>

            {/* Notificaciones */}
            <div className="bg-slate-600 rounded-lg p-4">
              <p className="text-sm font-bold mb-2">🔔 Notificaciones</p>
              <button
                onClick={() => {
                  if ('Notification' in window) {
                    Notification.requestPermission();
                    mostrarNotificacion('✅ Notificaciones activadas', 'success');
                  }
                }}
                className="w-full bg-purple-600 hover:bg-purple-700 py-2 rounded-lg font-bold text-sm"
              >
                Activar Notificaciones Push
              </button>
            </div>

            {/* Info */}
            <div className="bg-slate-600 p-3 rounded text-xs text-gray-300">
              <p>📱 <strong>AQUILES TRACKER v2</strong></p>
              <p className="mt-1">✅ Google Calendar integrado</p>
              <p>✅ Google Drive búsqueda</p>
              <p>✅ Sincronización en tiempo real</p>
              <p>✅ Notificaciones Push</p>
              <p>✅ Gráficas en vivo</p>
            </div>
          </div>
        </div>
      )}

      {/* TIMER FLOTANTE */}
      {timerVisible && timerData && (
        <TimerModal
          ejercicio={timerData.ejercicio}
          descansoSugerido={timerData.descanso}
          onCerrar={() => setTimerVisible(false)}
        />
      )}

      {/* NAVBAR INFERIOR */}
      <div className="fixed bottom-0 left-0 right-0 bg-slate-900 border-t border-slate-700 flex justify-around p-2">
        <NavButton icon={<Home size={24} />} label="Entrada" activo={pantalla === 'entrada'} onClick={() => setPantalla('entrada')} />
        <NavButton icon={<TrendingUp size={24} />} label="Historial" activo={pantalla === 'historial'} onClick={() => setPantalla('historial')} />
        <NavButton icon={<BarChart3 size={24} />} label="Dashboard" activo={pantalla === 'dashboard'} onClick={() => setPantalla('dashboard')} />
        <NavButton icon={<Settings size={24} />} label="Config" activo={pantalla === 'config'} onClick={() => setPantalla('config')} />
      </div>

      {/* Espacio para navbar */}
      <div className="h-20"></div>
    </div>
  );
}

// COMPONENTE: Pantalla de Entrada Rápida
function PantallaEntrada({ guardarEntrenamiento, ejercicios, onIniciarTimer }) {
  const [formulario, setFormulario] = useState({
    fecha: new Date().toISOString().split('T')[0],
    ejercicio: '',
    carga: '',
    reps: '',
    rpe: '8',
    variacion: '',
    esDropSet: false,
    notas: '',
    ronda: 1,
    objetivo: 'fuerza'
  });

  const [expandirAvanzado, setExpandirAvanzado] = useState(false);

  const handleChange = (e) => {
    const { name, value, type, checked } = e.target;
    setFormulario({
      ...formulario,
      [name]: type === 'checkbox' ? checked : value
    });
  };

  const handleGuardar = () => {
    if (!formulario.ejercicio || !formulario.carga || !formulario.reps) {
      alert('Completa: Ejercicio, Carga y Reps');
      return;
    }
    guardarEntrenamiento({
      ...formulario,
      fecha: new Date(formulario.fecha).getTime(),
      carga: parseFloat(formulario.carga),
      reps: parseInt(formulario.reps)
    });

    onIniciarTimer(formulario.ejercicio, parseFloat(formulario.rpe), formulario.objetivo);

    setFormulario({
      fecha: new Date().toISOString().split('T')[0],
      ejercicio: '',
      carga: '',
      reps: '',
      rpe: '8',
      variacion: '',
      esDropSet: false,
      notas: '',
      ronda: 1,
      objetivo: 'fuerza'
    });
  };

  const variaciones = ['Barra', 'Mancuernas', 'Máquina', 'Cable', 'Peso Corporal', 'Unilateral', 'Inclinado', 'Declinado'];

  return (
    <div className="p-4 pb-32 space-y-4">
      <div className="bg-slate-700 rounded-lg p-3">
        <label className="text-xs font-bold text-gray-300">📅 Fecha</label>
        <input
          type="date"
          name="fecha"
          value={formulario.fecha}
          onChange={handleChange}
          className="w-full bg-slate-600 text-white rounded py-2 px-3 mt-1 text-sm"
        />
      </div>

      <div className="bg-slate-700 rounded-lg p-3">
        <label className="text-xs font-bold text-gray-300">💪 Ejercicio</label>
        <select
          name="ejercicio"
          value={formulario.ejercicio}
          onChange={handleChange}
          className="w-full bg-slate-600 text-white rounded py-2 px-3 mt-1 text-sm"
        >
          <option value="">-- Selecciona --</option>
          {ejercicios.map(e => <option key={e} value={e}>{e}</option>)}
        </select>
      </div>

      <div className="grid grid-cols-2 gap-3">
        <div className="bg-slate-700 rounded-lg p-3">
          <label className="text-xs font-bold text-gray-300">⚖️ Carga (kg)</label>
          <input
            type="number"
            name="carga"
            value={formulario.carga}
            onChange={handleChange}
            placeholder="ej: 75"
            className="w-full bg-slate-600 text-white rounded py-2 px-3 mt-1 text-sm"
          />
        </div>
        <div className="bg-slate-700 rounded-lg p-3">
          <label className="text-xs font-bold text-gray-300">🔢 Reps</label>
          <input
            type="number"
            name="reps"
            value={formulario.reps}
            onChange={handleChange}
            placeholder="ej: 8"
            className="w-full bg-slate-600 text-white rounded py-2 px-3 mt-1 text-sm"
          />
        </div>
      </div>

      <div className="bg-slate-700 rounded-lg p-3">
        <label className="text-xs font-bold text-gray-300">⚡ RPE: {formulario.rpe}/10</label>
        <input
          type="range"
          name="rpe"
          min="1"
          max="10"
          step="0.5"
          value={formulario.rpe}
          onChange={handleChange}
          className="w-full mt-2"
        />
        <div className="flex justify-between text-xs text-gray-400 mt-1">
          <span>Fácil</span>
          <span>Máximo</span>
        </div>
      </div>

      <div className="bg-slate-700 rounded-lg p-3">
        <label className="text-xs font-bold text-gray-300">🔄 Ronda</label>
        <div className="flex gap-2 mt-2">
          {[1, 2, 3, 4, 5].map(r => (
            <button
              key={r}
              onClick={() => setFormulario({ ...formulario, ronda: r })}
              className={`flex-1 py-2 rounded font-bold text-sm ${formulario.ronda === r ? 'bg-orange-600' : 'bg-slate-600'}`}
            >
              R{r}
            </button>
          ))}
        </div>
      </div>

      <div className="bg-slate-700 rounded-lg p-3 border-l-4 border-purple-500">
        <label className="text-xs font-bold text-gray-300">🎯 Objetivo (para descanso)</label>
        <div className="grid grid-cols-3 gap-2 mt-2">
          {['fuerza', 'hipertrofia', 'resistencia'].map(obj => (
            <button
              key={obj}
              onClick={() => setFormulario({ ...formulario, objetivo: obj })}
              className={`py-2 rounded font-bold text-xs ${
                formulario.objetivo === obj ? 'bg-purple-600 text-white' : 'bg-slate-600 text-gray-300'
              }`}
            >
              {obj === 'fuerza' && '💪 Fuerza'}
              {obj === 'hipertrofia' && '📈 Hipertrofia'}
              {obj === 'resistencia' && '🔥 Resistencia'}
            </button>
          ))}
        </div>
      </div>

      <button
        onClick={() => setExpandirAvanzado(!expandirAvanzado)}
        className="w-full bg-slate-600 hover:bg-slate-500 py-2 rounded-lg text-sm font-bold"
      >
        {expandirAvanzado ? '▼' : '▶'} Opciones Avanzadas
      </button>

      {expandirAvanzado && (
        <>
          <div className="bg-slate-700 rounded-lg p-3 border-l-4 border-yellow-500">
            <label className="text-xs font-bold text-gray-300">🔀 Variación</label>
            <div className="flex flex-wrap gap-2 mt-2">
              {variaciones.map(v => (
                <button
                  key={v}
                  onClick={() => setFormulario({ ...formulario, variacion: formulario.variacion === v ? '' : v })}
                  className={`px-3 py-1 rounded text-xs font-bold ${formulario.variacion === v ? 'bg-yellow-600' : 'bg-slate-600'}`}
                >
                  {v}
                </button>
              ))}
            </div>
          </div>

          <div className="bg-slate-700 rounded-lg p-3 border-l-4 border-red-500">
            <label className="flex items-center gap-3 cursor-pointer">
              <input
                type="checkbox"
                name="esDropSet"
                checked={formulario.esDropSet}
                onChange={handleChange}
                className="w-5 h-5"
              />
              <span className="text-sm font-bold">🔥 ¿Es Drop Set?</span>
            </label>
          </div>

          <div className="bg-slate-700 rounded-lg p-3 border-l-4 border-blue-500">
            <label className="text-xs font-bold text-gray-300">📝 Notas (opcional)</label>
            <textarea
              name="notas"
              value={formulario.notas}
              onChange={handleChange}
              placeholder="Ej: Forma perfecta, mucho bombeo..."
              className="w-full bg-slate-600 text-white rounded py-2 px-3 mt-1 text-sm resize-none h-20"
            />
          </div>
        </>
      )}

      <button
        onClick={handleGuardar}
        className="w-full bg-gradient-to-r from-green-600 to-green-500 hover:from-green-700 hover:to-green-600 py-4 rounded-lg font-black text-lg flex items-center justify-center gap-3 shadow-lg transform hover:scale-105 transition"
      >
        <Plus size={28} /> GUARDAR SERIE
      </button>
    </div>
  );
}

// COMPONENTE: Pantalla de Historial
function PantallaHistorial({ entrenamientos, setEntrenamientos }) {
  const [filtroEjercicio, setFiltroEjercicio] = useState('');

  const filtrados = filtroEjercicio
    ? entrenamientos.filter(e => e.ejercicio === filtroEjercicio)
    : entrenamientos;

  const ejerciciosUnicos = [...new Set(entrenamientos.map(e => e.ejercicio))].sort();

  const borrar = (id) => {
    const actualizado = entrenamientos.filter(e => e.id !== id);
    setEntrenamientos(actualizado);
    localStorage.setItem('entrenamientos', JSON.stringify(actualizado));
  };

  return (
    <div className="p-4 pb-32 space-y-4">
      <select
        value={filtroEjercicio}
        onChange={(e) => setFiltroEjercicio(e.target.value)}
        className="w-full bg-slate-700 text-white rounded py-2 px-3 text-sm"
      >
        <option value="">📊 Todos ({entrenamientos.length})</option>
        {ejerciciosUnicos.map(e => (
          <option key={e} value={e}>{e}</option>
        ))}
      </select>

      <div className="space-y-2">
        {filtrados.length === 0 ? (
          <div className="bg-slate-700 p-6 rounded-lg text-center text-gray-400">
            No hay entrenamientos
          </div>
        ) : (
          filtrados.reverse().map(e => (
            <div key={e.id} className="bg-slate-700 rounded-lg p-3 border-l-4 border-orange-500">
              <div className="flex justify-between items-start">
                <div className="flex-1">
                  <p className="font-bold text-sm">{e.ejercicio}</p>
                  <p className="text-xs text-gray-300">
                    {e.carga}kg × {e.reps} | RPE {e.rpe} | Vol: {(e.carga * e.reps).toFixed(0)}kg
                  </p>
                  <p className="text-xs text-gray-400 mt-1">
                    📅 {new Date(e.fecha).toLocaleDateString('es-CL')}
                    {e.variacion && ` • ${e.variacion}`}
                    {e.esDropSet && ' • 🔥 Drop'}
                  </p>
                  {e.notas && <p className="text-xs text-yellow-300 mt-1">💬 {e.notas}</p>}
                </div>
                <button
                  onClick={() => borrar(e.id)}
                  className="text-red-400 hover:text-red-600 font-bold ml-2"
                >
                  ✕
                </button>
              </div>
            </div>
          ))
        )}
      </div>
    </div>
  );
}

// COMPONENTE: Pantalla Dashboard con Gráficas
function PantallaDashboard({ entrenamientos }) {
  if (entrenamientos.length === 0) {
    return (
      <div className="p-4 pb-32 text-center text-gray-400">
        <div className="bg-slate-700 p-8 rounded-lg mt-6">
          📈 No hay datos. ¡Empieza a entrenar!
        </div>
      </div>
    );
  }

  const ejerciciosUnicos = [...new Set(entrenamientos.map(e => e.ejercicio))];
  const totalVolumen = entrenamientos.reduce((sum, e) => sum + (e.carga * e.reps), 0);
  const promRPE = (entrenamientos.reduce((sum, e) => sum + parseInt(e.rpe), 0) / entrenamientos.length).toFixed(1);

  // PRs
  const prs = {};
  ejerciciosUnicos.forEach(ej => {
    const del = entrenamientos.filter(e => e.ejercicio === ej);
    prs[ej] = Math.max(...del.map(e => e.carga));
  });

  // Datos para gráfica de progreso (últimos 10 días)
  const ultimos10 = entrenamientos.slice(-10);
  const volumesPorDia = {};
  ultimos10.forEach(e => {
    const fecha = new Date(e.fecha).toLocaleDateString('es-CL');
    volumesPorDia[fecha] = (volumesPorDia[fecha] || 0) + (e.carga * e.reps);
  });

  return (
    <div className="p-4 pb-32 space-y-4">
      {/* STATS */}
      <div className="grid grid-cols-2 gap-3">
        <TarjetaStats label="Total" valor={entrenamientos.length} icon="🏋️" />
        <TarjetaStats label="Volumen" valor={`${totalVolumen.toFixed(0)}kg`} icon="📊" />
        <TarjetaStats label="Promedio RPE" valor={promRPE} icon="⚡" />
        <TarjetaStats label="Ejercicios" valor={ejerciciosUnicos.length} icon="💪" />
      </div>

      {/* GRÁFICA DE PROGRESO */}
      <div className="bg-slate-700 rounded-lg p-4">
        <h3 className="font-bold text-sm mb-3">📈 Volumen últimos 10 días</h3>
        <div className="bg-slate-600 rounded p-3 h-40 flex items-end gap-1 justify-center">
          {Object.values(volumesPorDia).map((vol, i) => {
            const maxVol = Math.max(...Object.values(volumesPorDia));
            const height = (vol / maxVol) * 100;
            return (
              <div
                key={i}
                className="flex-1 bg-gradient-to-t from-orange-600 to-orange-400 rounded-t"
                style={{ height: `${height}%`, minHeight: '4px' }}
                title={`${vol.toFixed(0)}kg`}
              />
            );
          })}
        </div>
        <p className="text-xs text-gray-400 mt-2">
          Promedio: {(Object.values(volumesPorDia).reduce((a, b) => a + b, 0) / Object.values(volumesPorDia).length).toFixed(0)}kg/día
        </p>
      </div>

      {/* PRs */}
      <div className="bg-slate-700 rounded-lg p-4">
        <h2 className="text-lg font-bold mb-3">👑 RÉCORDS PERSONALES</h2>
        <div className="space-y-2 max-h-96 overflow-y-auto">
          {Object.entries(prs)
            .sort(([, a], [, b]) => b - a)
            .slice(0, 15)
            .map(([ejercicio, carga]) => (
              <div key={ejercicio} className="flex justify-between items-center bg-slate-600 p-2 rounded text-sm">
                <span className="font-bold">{ejercicio}</span>
                <span className="text-green-400 font-black">{carga}kg</span>
              </div>
            ))}
        </div>
      </div>

      {/* ÚLTIMAS SESIONES */}
      <div className="bg-slate-700 rounded-lg p-4">
        <h2 className="text-lg font-bold mb-3">📅 ÚLTIMAS SESIONES</h2>
        <div className="space-y-2 max-h-64 overflow-y-auto">
          {entrenamientos
            .sort((a, b) => b.fecha - a.fecha)
            .slice(0, 10)
            .map(e => (
              <div key={e.id} className="bg-slate-600 p-2 rounded text-xs">
                <p className="font-bold">{e.ejercicio}</p>
                <p className="text-gray-300">{e.carga}kg × {e.reps} | RPE {e.rpe}</p>
              </div>
            ))}
        </div>
      </div>
    </div>
  );
}

// COMPONENTE: Timer Modal Inteligente
function TimerModal({ ejercicio, descansoSugerido, onCerrar }) {
  const [tiempoRestante, setTiempoRestante] = useState(descansoSugerido);
  const [tiempoPersonalizado, setTiempoPersonalizado] = useState(descansoSugerido);
  const [tiempoActual, setTiempoActual] = useState(descansoSugerido);
  const [enPausa, setEnPausa] = useState(false);
  const [activo, setActivo] = useState(true);
  const [sonidoActivado, setSonidoActivado] = useState(true);
  const [musicaActivada, setMusicaActivada] = useState(false);

  useEffect(() => {
    if (!activo || enPausa) return;

    const intervalo = setInterval(() => {
      setTiempoRestante(prev => {
        if (prev <= 1) {
          if (sonidoActivado) {
            reproducirSonido();
          }
          setActivo(false);
          return 0;
        }
        return prev - 1;
      });
    }, 1000);

    return () => clearInterval(intervalo);
  }, [activo, enPausa, sonidoActivado]);

  const reproducirSonido = () => {
    try {
      const audioContext = new (window.AudioContext || window.webkitAudioContext)();
      const osc = audioContext.createOscillator();
      const gain = audioContext.createGain();
      osc.connect(gain);
      gain.connect(audioContext.destination);
      osc.frequency.value = 800;
      gain.gain.setValueAtTime(0.3, audioContext.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.01, audioContext.currentTime + 0.5);
      osc.start(audioContext.currentTime);
      osc.stop(audioContext.currentTime + 0.5);
    } catch (e) {}
  };

  const formatearTiempo = (segundos) => {
    const mins = Math.floor(segundos / 60);
    const segs = segundos % 60;
    return `${mins}:${segs.toString().padStart(2, '0')}`;
  };

  const handleCambiarTiempo = (nuevos) => {
    setTiempoPersonalizado(nuevos);
    setTiempoRestante(nuevos);
    setTiempoActual(nuevos);
  };

  let colorFondo = 'from-blue-600 to-blue-500';
  if (tiempoRestante <= 10 && tiempoRestante > 0) colorFondo = 'from-yellow-600 to-yellow-500';
  if (tiempoRestante <= 5 && tiempoRestante > 0) colorFondo = 'from-red-600 to-red-500';
  if (tiempoRestante === 0) colorFondo = 'from-green-600 to-green-500';

  return (
    <div className="fixed inset-0 bg-black bg-opacity-75 flex items-center justify-center z-50 p-4">
      <div className="bg-gradient-to-br from-slate-800 to-slate-900 rounded-2xl p-8 w-full max-w-sm shadow-2xl">
        <button
          onClick={onCerrar}
          className="absolute top-4 right-4 text-gray-400 hover:text-white text-2xl"
        >
          ✕
        </button>

        <div className="text-center mb-6">
          <p className="text-gray-400 text-sm">⏸️ DESCANSO ENTRE SERIES</p>
          <p className="text-white font-bold text-lg mt-1">{ejercicio}</p>
        </div>

        <div className={`bg-gradient-to-r ${colorFondo} rounded-2xl p-8 mb-6 text-center shadow-lg`}>
          <div className="text-6xl font-black text-white mb-2 font-mono">
            {formatearTiempo(tiempoRestante)}
          </div>
          <p className="text-white text-xs opacity-75">
            {tiempoRestante > 0
              ? tiempoRestante <= 5
                ? '⚡ ¡LISTOOO!'
                : '⏳ Recuperando...'
              : '✅ ¡TIEMPO!'}
          </p>
        </div>

        <div className="w-full bg-slate-700 rounded-full h-2 mb-6 overflow-hidden">
          <div
            className="bg-gradient-to-r from-orange-500 to-orange-400 h-full rounded-full transition-all"
            style={{
              width: `${((tiempoActual - tiempoRestante) / tiempoActual) * 100}%`
            }}
          />
        </div>

        <div className="flex gap-3 mb-6">
          <button
            onClick={() => setEnPausa(!enPausa)}
            className={`flex-1 py-3 rounded-lg font-bold flex items-center justify-center gap-2 transition ${
              enPausa
                ? 'bg-green-600 hover:bg-green-700'
                : 'bg-yellow-600 hover:bg-yellow-700'
            }`}
          >
            {enPausa ? <Play size={20} /> : <Pause size={20} />}
            {enPausa ? 'Reanudar' : 'Pausar'}
          </button>
          <button
            onClick={() => setSonidoActivado(!sonidoActivado)}
            className={`py-3 px-4 rounded-lg font-bold ${
              sonidoActivado ? 'bg-blue-600' : 'bg-slate-600'
            }`}
          >
            {sonidoActivado ? '🔊' : '🔇'}
          </button>
          <button
            onClick={() => setMusicaActivada(!musicaActivada)}
            className={`py-3 px-4 rounded-lg font-bold ${
              musicaActivada ? 'bg-purple-600' : 'bg-slate-600'
            }`}
            title="Música de relajación"
          >
            {musicaActivada ? '🎵' : '🎶'}
          </button>
        </div>

        <div className="bg-slate-700 rounded-lg p-4 mb-6">
          <p className="text-xs font-bold text-gray-300 mb-3">⚙️ Personalizar Descanso</p>
          <div className="grid grid-cols-3 gap-2 mb-4">
            {[30, 60, 90, 120, 150, 180].map(seg => (
              <button
                key={seg}
                onClick={() => handleCambiarTiempo(seg)}
                className={`py-2 rounded font-bold text-sm transition ${
                  tiempoPersonalizado === seg
                    ? 'bg-orange-600 text-white'
                    : 'bg-slate-600 text-gray-300 hover:bg-slate-500'
                }`}
              >
                {seg < 60 ? `${seg}s` : `${Math.floor(seg / 60)}m`}
              </button>
            ))}
          </div>

          <div className="flex gap-2">
            <input
              type="number"
              value={tiempoPersonalizado}
              onChange={(e) => {
                const valor = Math.max(15, Math.min(600, parseInt(e.target.value) || 0));
                setTiempoPersonalizado(valor);
              }}
              className="flex-1 bg-slate-600 text-white rounded px-3 py-2 text-sm font-bold"
              placeholder="Segundos"
            />
            <button
              onClick={() => handleCambiarTiempo(tiempoPersonalizado)}
              className="bg-blue-600 hover:bg-blue-700 px-4 py-2 rounded font-bold text-sm"
            >
              OK
            </button>
          </div>
        </div>

        <div className="bg-slate-600 rounded-lg p-3 text-center text-xs text-gray-300 mb-4">
          <p>💡 <strong>Tip:</strong> Descansa bien entre series</p>
          <p className="mt-1 text-gray-400">Tiempo sugerido: {Math.floor(descansoSugerido / 60)}m {descansoSugerido % 60}s</p>
        </div>

        <button
          onClick={onCerrar}
          className="w-full bg-gradient-to-r from-green-600 to-green-500 hover:from-green-700 hover:to-green-600 py-3 rounded-lg font-black text-white flex items-center justify-center gap-2 transition transform hover:scale-105"
        >
          ✅ SIGUIENTE SERIE
        </button>
      </div>
    </div>
  );
}

